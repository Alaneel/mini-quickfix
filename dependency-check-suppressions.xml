<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
    This file contains suppressions for known false positives in OWASP Dependency Check.
    Each suppression should include:
    - Reason for suppression
    - Date added
    - Issue tracking reference (if applicable)
    -->

    <!-- Example suppression
    <suppress>
        <notes><![CDATA[
        False positive: CVE is for a different component
        Added: 2025-01-13
        Ticket: PROJ-123
        ]]></notes>
        <cve>CVE-2021-12345</cve>
    </suppress>
    -->

    <!-- JUnit transitive dependencies -->
    <suppress>
        <notes><![CDATA[
        Test-only dependency, not included in production artifacts
        ]]></notes>
        <gav regex="true">^org\.junit\..*:.*:.*$</gav>
    </suppress>

</suppressions>
